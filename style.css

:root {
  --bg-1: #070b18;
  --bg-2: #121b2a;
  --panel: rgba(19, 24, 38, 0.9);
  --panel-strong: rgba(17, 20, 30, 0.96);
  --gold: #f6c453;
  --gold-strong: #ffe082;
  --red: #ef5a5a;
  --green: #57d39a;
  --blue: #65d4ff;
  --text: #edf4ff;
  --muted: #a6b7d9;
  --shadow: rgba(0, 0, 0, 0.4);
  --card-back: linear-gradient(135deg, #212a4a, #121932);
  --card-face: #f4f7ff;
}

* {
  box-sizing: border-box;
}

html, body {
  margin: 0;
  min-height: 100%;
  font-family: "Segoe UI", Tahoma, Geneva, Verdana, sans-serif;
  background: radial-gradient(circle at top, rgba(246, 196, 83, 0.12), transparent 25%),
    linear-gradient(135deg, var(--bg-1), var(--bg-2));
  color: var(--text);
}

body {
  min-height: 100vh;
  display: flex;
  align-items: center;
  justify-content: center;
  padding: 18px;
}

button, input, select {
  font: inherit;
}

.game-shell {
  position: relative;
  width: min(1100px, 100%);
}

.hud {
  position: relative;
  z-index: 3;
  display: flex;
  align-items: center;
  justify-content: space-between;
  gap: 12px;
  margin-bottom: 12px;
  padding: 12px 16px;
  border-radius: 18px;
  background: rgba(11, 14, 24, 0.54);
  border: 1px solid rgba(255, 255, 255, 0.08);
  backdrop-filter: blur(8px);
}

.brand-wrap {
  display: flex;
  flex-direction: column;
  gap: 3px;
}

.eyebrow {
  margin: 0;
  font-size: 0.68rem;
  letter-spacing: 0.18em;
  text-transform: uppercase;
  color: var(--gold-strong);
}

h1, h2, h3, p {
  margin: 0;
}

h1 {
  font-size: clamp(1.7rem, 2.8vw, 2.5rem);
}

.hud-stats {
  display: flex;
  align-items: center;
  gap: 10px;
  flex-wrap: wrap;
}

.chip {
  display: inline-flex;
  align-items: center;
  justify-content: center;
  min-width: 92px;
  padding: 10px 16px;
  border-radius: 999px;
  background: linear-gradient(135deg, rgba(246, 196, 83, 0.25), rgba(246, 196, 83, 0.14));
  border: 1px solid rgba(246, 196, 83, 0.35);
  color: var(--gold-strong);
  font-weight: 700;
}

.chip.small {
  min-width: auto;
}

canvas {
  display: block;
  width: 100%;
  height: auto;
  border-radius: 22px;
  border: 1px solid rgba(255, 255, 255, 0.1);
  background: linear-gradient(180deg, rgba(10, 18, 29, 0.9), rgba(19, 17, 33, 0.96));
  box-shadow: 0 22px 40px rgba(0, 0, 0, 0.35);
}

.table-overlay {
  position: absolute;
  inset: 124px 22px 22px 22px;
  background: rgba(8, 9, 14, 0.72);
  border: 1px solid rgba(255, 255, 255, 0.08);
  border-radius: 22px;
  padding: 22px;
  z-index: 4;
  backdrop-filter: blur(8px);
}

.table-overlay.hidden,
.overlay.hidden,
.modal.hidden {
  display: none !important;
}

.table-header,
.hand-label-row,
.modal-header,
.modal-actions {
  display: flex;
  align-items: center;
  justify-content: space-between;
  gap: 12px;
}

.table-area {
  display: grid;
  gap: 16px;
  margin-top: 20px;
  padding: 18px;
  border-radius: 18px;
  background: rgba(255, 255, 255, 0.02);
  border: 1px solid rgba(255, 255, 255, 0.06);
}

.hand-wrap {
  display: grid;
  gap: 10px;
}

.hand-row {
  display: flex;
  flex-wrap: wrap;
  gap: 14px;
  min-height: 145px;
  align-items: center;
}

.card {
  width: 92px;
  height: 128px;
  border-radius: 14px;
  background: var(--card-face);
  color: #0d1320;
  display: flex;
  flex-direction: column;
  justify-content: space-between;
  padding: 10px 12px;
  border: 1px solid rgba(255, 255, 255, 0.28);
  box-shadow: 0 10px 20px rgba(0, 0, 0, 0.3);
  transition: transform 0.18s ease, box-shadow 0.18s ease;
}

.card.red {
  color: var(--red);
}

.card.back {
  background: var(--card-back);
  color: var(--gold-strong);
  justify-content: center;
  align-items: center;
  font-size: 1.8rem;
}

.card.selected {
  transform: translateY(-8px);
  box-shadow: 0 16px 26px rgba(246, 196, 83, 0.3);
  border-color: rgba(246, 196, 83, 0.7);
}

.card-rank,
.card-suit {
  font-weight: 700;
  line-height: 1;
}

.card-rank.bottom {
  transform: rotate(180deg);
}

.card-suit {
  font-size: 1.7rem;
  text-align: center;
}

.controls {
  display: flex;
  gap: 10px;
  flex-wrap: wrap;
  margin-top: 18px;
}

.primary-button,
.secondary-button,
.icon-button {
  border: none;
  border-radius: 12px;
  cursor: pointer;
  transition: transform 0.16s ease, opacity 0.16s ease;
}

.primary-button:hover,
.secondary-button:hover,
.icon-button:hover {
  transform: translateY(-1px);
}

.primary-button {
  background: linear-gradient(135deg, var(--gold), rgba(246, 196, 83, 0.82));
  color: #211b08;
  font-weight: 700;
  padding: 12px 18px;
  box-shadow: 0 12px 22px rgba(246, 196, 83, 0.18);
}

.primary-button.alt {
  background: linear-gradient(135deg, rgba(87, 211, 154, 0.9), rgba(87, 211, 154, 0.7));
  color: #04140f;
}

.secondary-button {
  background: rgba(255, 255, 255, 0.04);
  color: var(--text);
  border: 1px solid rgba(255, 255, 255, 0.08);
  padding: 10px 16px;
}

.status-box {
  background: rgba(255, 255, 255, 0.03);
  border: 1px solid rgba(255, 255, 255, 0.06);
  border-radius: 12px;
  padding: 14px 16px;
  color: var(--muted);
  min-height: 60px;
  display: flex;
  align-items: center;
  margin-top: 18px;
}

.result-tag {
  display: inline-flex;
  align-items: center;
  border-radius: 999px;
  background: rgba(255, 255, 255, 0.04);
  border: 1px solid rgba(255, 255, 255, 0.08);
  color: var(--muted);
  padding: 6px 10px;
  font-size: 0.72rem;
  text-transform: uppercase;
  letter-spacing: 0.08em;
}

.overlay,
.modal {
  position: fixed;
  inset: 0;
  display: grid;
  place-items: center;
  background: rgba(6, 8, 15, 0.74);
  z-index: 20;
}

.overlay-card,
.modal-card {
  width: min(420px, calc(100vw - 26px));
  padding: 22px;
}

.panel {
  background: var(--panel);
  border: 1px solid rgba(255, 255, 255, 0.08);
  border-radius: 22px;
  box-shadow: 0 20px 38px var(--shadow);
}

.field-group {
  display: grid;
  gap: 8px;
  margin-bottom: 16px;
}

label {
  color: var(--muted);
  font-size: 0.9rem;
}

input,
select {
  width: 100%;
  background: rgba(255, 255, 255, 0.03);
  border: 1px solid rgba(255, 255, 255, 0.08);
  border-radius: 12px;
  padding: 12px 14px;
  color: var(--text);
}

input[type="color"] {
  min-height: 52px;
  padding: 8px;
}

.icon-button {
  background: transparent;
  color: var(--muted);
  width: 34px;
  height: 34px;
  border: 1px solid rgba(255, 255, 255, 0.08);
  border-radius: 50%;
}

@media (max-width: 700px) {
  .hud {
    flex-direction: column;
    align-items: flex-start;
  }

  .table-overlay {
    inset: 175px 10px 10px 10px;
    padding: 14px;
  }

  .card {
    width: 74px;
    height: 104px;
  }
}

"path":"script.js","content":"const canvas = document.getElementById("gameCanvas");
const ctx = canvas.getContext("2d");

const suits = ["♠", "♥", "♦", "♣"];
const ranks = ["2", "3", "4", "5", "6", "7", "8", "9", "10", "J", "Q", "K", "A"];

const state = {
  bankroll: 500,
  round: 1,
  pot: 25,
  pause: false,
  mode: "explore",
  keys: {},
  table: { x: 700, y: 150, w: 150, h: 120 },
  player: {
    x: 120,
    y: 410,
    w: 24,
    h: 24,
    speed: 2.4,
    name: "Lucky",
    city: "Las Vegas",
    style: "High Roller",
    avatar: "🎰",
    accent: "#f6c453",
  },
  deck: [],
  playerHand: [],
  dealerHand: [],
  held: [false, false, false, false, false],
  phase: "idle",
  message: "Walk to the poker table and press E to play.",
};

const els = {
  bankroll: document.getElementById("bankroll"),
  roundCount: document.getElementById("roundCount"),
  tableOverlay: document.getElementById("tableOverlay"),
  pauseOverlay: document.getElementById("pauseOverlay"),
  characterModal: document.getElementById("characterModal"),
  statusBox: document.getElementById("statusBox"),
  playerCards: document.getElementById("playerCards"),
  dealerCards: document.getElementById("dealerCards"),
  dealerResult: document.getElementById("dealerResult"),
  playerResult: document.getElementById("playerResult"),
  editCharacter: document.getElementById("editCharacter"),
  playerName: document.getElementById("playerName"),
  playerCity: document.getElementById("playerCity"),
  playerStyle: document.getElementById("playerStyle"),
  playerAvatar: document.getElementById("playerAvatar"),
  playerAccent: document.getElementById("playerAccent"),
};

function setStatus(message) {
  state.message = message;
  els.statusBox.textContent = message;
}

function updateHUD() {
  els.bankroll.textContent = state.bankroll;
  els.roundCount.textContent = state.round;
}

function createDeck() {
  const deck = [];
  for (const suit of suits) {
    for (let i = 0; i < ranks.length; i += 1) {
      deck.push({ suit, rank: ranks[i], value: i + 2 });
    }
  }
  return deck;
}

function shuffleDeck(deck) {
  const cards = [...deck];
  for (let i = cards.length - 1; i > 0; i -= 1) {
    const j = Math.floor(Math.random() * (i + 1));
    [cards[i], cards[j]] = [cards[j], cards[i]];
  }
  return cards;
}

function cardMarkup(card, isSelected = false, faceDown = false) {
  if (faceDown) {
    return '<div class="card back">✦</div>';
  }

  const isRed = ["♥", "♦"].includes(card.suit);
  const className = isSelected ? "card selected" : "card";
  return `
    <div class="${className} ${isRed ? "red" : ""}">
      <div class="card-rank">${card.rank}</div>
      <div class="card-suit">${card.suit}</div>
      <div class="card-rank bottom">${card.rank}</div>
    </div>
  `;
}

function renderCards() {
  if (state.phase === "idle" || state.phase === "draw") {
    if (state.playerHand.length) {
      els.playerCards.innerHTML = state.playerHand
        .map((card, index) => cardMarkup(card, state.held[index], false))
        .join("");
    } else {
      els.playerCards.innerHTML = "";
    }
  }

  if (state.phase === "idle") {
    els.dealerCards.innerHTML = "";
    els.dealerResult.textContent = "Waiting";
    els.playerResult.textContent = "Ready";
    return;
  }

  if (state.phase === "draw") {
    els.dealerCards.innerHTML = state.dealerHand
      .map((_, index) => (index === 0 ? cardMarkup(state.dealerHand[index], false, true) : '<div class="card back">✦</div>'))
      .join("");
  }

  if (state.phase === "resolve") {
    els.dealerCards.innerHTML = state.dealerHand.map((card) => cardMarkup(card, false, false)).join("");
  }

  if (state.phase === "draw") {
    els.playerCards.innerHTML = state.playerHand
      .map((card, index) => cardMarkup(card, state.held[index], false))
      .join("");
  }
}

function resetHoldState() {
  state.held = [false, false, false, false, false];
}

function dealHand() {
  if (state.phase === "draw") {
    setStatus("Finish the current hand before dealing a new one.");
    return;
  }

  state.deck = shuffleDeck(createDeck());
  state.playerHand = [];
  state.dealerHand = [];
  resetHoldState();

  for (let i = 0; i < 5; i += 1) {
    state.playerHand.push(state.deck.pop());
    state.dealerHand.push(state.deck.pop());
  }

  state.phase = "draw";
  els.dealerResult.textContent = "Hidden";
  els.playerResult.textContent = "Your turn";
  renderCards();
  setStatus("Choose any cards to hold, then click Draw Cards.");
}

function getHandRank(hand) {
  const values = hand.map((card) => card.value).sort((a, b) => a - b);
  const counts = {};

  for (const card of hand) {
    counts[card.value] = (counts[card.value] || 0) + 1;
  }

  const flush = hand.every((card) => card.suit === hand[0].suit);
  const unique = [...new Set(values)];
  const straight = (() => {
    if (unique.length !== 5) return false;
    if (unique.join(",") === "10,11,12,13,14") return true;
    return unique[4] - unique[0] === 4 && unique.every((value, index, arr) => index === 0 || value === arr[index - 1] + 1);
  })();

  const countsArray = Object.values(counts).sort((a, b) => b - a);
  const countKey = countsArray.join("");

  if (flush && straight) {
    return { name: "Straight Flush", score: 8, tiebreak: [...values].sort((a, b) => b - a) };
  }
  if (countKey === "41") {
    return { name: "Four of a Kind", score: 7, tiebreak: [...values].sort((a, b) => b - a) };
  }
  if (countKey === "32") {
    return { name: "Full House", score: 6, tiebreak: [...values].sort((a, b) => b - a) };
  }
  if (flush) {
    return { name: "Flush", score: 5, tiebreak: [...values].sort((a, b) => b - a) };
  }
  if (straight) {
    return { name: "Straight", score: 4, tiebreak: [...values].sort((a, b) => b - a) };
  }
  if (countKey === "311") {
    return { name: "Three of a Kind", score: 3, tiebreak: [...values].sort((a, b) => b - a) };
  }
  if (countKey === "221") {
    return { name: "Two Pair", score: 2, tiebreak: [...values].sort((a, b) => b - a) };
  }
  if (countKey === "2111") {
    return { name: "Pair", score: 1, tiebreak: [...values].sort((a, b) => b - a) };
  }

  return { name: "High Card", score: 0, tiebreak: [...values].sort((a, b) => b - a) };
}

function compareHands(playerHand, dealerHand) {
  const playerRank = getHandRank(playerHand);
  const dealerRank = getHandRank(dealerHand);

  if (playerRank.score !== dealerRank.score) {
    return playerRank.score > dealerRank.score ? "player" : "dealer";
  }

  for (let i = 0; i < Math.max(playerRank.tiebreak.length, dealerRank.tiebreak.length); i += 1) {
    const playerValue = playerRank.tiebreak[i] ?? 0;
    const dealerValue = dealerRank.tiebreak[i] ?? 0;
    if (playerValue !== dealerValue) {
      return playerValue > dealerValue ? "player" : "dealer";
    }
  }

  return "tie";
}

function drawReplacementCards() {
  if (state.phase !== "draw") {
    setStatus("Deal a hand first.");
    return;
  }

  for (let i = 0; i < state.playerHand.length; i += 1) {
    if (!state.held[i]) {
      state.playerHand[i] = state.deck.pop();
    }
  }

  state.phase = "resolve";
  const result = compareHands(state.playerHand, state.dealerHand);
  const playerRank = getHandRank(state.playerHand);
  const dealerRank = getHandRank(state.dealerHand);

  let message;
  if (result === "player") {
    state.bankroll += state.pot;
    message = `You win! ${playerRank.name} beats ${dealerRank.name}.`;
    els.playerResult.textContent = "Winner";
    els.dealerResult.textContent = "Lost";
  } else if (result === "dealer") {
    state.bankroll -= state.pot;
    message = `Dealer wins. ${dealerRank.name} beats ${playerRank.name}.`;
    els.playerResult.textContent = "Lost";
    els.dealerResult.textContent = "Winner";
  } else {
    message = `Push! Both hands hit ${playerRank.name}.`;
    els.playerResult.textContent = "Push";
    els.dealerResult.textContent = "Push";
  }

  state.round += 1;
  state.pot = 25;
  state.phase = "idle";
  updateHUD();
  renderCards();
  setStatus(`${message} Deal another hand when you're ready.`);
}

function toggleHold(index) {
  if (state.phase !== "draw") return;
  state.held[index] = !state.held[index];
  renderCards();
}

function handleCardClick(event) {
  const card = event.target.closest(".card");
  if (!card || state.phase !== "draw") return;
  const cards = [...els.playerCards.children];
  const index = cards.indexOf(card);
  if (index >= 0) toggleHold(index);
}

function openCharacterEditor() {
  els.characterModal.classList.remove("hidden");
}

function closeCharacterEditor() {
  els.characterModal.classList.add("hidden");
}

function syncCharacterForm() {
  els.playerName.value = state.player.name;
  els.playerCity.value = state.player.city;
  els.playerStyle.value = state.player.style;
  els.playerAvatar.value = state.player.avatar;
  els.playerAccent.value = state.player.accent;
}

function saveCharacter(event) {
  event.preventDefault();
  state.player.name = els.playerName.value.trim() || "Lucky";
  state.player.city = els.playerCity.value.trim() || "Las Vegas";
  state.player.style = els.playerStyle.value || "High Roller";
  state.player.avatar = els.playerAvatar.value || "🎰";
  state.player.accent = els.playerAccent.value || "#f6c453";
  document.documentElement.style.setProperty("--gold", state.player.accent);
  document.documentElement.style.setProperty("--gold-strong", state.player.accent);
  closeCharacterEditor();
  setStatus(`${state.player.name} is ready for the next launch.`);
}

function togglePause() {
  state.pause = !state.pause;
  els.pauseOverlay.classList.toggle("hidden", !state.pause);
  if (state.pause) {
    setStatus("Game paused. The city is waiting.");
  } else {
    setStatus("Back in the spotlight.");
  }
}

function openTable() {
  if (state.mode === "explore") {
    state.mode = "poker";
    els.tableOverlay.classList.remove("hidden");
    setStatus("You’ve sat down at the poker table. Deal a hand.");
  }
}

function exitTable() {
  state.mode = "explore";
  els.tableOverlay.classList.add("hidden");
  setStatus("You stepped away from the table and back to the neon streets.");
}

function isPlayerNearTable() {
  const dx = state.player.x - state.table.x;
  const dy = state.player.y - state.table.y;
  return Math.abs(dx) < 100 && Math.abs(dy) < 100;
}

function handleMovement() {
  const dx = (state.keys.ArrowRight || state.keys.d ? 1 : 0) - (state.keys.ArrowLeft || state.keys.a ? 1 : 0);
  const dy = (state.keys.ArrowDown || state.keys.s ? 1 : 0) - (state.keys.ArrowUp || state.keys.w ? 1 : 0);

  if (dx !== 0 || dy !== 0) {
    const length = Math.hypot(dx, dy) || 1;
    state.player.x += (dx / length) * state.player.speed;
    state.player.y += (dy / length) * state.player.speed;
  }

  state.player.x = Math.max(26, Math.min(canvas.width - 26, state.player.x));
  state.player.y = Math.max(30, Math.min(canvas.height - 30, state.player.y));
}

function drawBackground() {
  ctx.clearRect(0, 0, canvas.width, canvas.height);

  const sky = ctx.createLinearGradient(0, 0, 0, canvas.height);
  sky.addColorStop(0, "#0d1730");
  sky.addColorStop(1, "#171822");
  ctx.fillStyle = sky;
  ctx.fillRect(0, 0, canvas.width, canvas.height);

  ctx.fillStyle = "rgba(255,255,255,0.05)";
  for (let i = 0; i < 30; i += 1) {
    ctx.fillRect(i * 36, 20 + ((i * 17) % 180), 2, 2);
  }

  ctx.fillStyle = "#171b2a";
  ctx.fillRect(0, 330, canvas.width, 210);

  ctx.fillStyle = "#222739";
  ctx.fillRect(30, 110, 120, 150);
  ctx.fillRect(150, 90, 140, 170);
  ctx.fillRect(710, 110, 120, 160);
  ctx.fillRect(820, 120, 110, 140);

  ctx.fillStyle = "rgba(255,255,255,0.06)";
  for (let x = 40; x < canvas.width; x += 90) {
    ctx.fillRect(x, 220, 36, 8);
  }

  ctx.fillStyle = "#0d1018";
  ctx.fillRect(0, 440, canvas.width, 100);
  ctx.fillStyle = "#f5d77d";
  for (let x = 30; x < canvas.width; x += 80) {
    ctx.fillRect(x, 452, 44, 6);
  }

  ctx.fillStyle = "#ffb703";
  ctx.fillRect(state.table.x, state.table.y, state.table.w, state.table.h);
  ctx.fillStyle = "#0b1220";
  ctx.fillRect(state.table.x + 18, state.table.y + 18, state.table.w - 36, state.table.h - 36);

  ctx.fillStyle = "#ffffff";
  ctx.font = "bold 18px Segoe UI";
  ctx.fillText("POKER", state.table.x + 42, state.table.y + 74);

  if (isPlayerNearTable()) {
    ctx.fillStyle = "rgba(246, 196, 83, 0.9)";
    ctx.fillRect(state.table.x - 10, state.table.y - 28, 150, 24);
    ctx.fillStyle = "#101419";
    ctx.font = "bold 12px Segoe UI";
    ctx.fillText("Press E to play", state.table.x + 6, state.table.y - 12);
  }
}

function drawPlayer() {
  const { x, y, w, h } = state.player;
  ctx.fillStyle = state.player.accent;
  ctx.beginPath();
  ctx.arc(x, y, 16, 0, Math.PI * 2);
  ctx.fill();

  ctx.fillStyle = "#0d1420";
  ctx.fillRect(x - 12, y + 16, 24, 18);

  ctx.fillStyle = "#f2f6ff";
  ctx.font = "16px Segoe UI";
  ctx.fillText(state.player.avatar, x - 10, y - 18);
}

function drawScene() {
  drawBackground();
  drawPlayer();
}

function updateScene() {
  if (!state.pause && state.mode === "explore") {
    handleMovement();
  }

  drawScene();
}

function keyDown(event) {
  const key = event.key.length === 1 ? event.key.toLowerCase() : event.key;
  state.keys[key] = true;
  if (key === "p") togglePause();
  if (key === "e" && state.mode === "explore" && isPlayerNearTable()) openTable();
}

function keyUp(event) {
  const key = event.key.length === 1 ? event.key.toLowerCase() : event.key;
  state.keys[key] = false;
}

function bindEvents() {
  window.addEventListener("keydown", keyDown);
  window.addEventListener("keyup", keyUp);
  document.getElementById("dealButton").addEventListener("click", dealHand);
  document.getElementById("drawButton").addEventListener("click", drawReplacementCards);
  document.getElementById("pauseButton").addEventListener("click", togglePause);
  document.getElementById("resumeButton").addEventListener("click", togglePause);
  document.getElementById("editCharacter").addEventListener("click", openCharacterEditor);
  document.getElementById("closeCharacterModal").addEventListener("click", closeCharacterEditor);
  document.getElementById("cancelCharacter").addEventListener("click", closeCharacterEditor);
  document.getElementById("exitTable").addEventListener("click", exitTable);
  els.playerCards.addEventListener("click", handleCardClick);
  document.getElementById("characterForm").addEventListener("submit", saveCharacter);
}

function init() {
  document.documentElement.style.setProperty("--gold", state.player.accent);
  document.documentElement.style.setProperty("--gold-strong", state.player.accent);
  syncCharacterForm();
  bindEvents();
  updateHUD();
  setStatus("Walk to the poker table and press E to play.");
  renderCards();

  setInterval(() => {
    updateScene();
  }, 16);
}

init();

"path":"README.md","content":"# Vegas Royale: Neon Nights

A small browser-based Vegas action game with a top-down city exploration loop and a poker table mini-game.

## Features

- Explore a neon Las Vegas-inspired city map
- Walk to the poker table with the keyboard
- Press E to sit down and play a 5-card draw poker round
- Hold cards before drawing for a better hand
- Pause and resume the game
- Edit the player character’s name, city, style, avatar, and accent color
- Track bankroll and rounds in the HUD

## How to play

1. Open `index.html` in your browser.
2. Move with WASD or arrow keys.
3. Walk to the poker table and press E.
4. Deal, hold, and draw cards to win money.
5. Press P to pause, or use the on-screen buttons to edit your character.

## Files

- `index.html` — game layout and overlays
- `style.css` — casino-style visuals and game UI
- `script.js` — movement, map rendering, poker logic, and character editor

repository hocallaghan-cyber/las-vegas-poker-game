<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vegas Royale: Neon Nights</title>
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div class="game-shell">
      <div class="hud">
        <div class="brand-wrap">
          <p class="eyebrow">Neon District</p>
          <h1>Vegas Royale</h1>
        </div>
        <div class="hud-stats">
          <span class="chip">$<span id="bankroll">500</span></span>
          <span class="chip small">Round <span id="roundCount">1</span></span>
          <button id="pauseButton" class="secondary-button">Pause</button>
          <button id="editCharacter" class="secondary-button">Edit Character</button>
        </div>
      </div>

      <canvas id="gameCanvas" width="960" height="540" aria-label="Vegas alley game map"></canvas>

      <div id="tableOverlay" class="table-overlay hidden">
        <div class="table-header">
          <div>
            <p class="eyebrow">Casino table</p>
            <h2>High Stakes Poker</h2>
          </div>
          <button id="exitTable" class="secondary-button">Leave Table</button>
        </div>

        <div class="table-area">
          <div class="hand-wrap">
            <div class="hand-label-row">
              <span>Dealer</span>
              <span id="dealerResult" class="result-tag">Waiting</span>
            </div>
            <div id="dealerCards" class="hand-row" aria-live="polite"></div>
          </div>

          <div class="hand-wrap player-area">
            <div class="hand-label-row">
              <span>Your hand</span>
              <span id="playerResult" class="result-tag">Ready</span>
            </div>
            <div id="playerCards" class="hand-row" aria-live="polite"></div>
          </div>
        </div>

        <div class="controls">
          <button id="dealButton" class="primary-button">Deal Hand</button>
          <button id="drawButton" class="primary-button alt">Draw Cards</button>
        </div>

        <div id="statusBox" class="status-box">Walk to the poker table and hit E to play.</div>
      </div>
    </div>

    <div id="pauseOverlay" class="overlay hidden" aria-live="assertive">
      <div class="overlay-card panel">
        <p class="eyebrow">Game paused</p>
        <h2>Take a breather</h2>
        <p>The city is still glowing. Resume whenever you're ready to gamble again.</p>
        <button id="resumeButton" class="primary-button">Resume</button>
      </div>
    </div>

    <div id="characterModal" class="modal hidden" aria-modal="true" role="dialog">
      <div class="panel modal-card">
        <div class="modal-header">
          <h2>Edit Character</h2>
          <button id="closeCharacterModal" class="icon-button" aria-label="Close">✕</button>
        </div>

        <form id="characterForm">
          <div class="field-group">
            <label for="playerName">Name</label>
            <input id="playerName" name="playerName" type="text" maxlength="18" value="Lucky" />
          </div>

          <div class="field-group">
            <label for="playerCity">City</label>
            <input id="playerCity" name="playerCity" type="text" maxlength="24" value="Las Vegas" />
          </div>

          <div class="field-group">
            <label for="playerStyle">Style</label>
            <select id="playerStyle" name="playerStyle">
              <option>High Roller</option>
              <option>Card Shark</option>
              <option>Night Owl</option>
              <option>Lucky Charm</option>
            </select>
          </div>

          <div class="field-group">
            <label for="playerAvatar">Avatar</label>
            <select id="playerAvatar" name="playerAvatar">
              <option value="🎰">🎰 Casino</option>
              <option value="🃏">🃏 Joker</option>
              <option value="💎">💎 Diamond</option>
              <option value="⭐">⭐ Star</option>
              <option value="🕶️">🕶️ Shades</option>
            </select>
          </div>

          <div class="field-group">
            <label for="playerAccent">Accent Color</label>
            <input id="playerAccent" name="playerAccent" type="color" value="#f6c453" />
          </div>

          <div class="modal-actions">
            <button type="button" id="cancelCharacter" class="secondary-button">Cancel</button>
            <button type="submit" class="primary-button">Save</button>
          </div>
        </form>
      </div>
    </div>

    <script src="script.js"></script>
  </body>
</html>
